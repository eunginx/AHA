PUID=1000
PGID=1000
TZ=Etc/UTC
CONFIG_PATH=/Users/kapilh/obsidian-config
SHM_SIZE=1gb
OBSIDIAN_IMAGE=linuxserver/obsidian:1.12.7
OBSIDIAN_CONTAINER_NAME=obsidian
HTTP_PORT=3000
HTTPS_PORT=3001

# --- OAuth2 / SSO (via oauth2-proxy) ---
# Set to false to skip the proxy and expose Obsidian directly (see docker-compose.yml comments)
OAUTH2_ENABLED=true
OAUTH2_PROVIDER=oidc
OAUTH2_CLIENT_ID=zcbuHFMTw4GeAxJHwzvf4wtRwhpe2F2ELYaFaDJv
OAUTH2_CLIENT_SECRET=hdIgsw74abXMy3X5q80TXVcC3Ekkdhyg4TErosMyAPJhxI8VrzueB1ass1UAFNzWD27awo6MaxL1PkzqeDRVKq2lXbHgUL2vLTai3nl4wygpDwKd6ohs12WhRa9KgP4m
OAUTH2_OIDC_ISSUER_URL=https://auth.sorsiri.in/application/o/osbidian/
OAUTH2_REDIRECT_URL=https://aha.sorsiri.in/oauth2/callback
# Must be exactly 16, 24, or 32 ASCII characters. Regenerate with:
# python3 -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(32)))"
OAUTH2_COOKIE_SECRET=MK1rWObj6uCWMM3CLtmWM82VfynPCMNC
OAUTH2_EMAIL_DOMAIN=sorsiri.in,key2vibe.com,sorsiri.com

# IMPORTANT: Since aha.sorsiri.in uses HTTPS, cookie_secure must be true
OAUTH2_PROXY_COOKIE_SECURE=true
