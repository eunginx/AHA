# Production .env for EC2 / TeamCity deployment
# Copy this to .env on your server and fill in real values

PUID=1000
PGID=1000
TZ=Etc/UTC

# On EC2 use a host path that exists (e.g., /opt/obsidian-config or a Docker volume)
CONFIG_PATH=/opt/obsidian-config
SHM_SIZE=1gb

OBSIDIAN_IMAGE=linuxserver/obsidian:1.12.7
OBSIDIAN_CONTAINER_NAME=obsidian

# If running behind a reverse proxy (nginx/caddy), you can keep 3000 internal.
# If exposing directly, use 80/443.
HTTP_PORT=3000
HTTPS_PORT=3001

# --- OAuth2 / SSO (via oauth2-proxy) ---
OAUTH2_ENABLED=true
OAUTH2_PROVIDER=oidc
OAUTH2_CLIENT_ID=<your-client-id>
OAUTH2_CLIENT_SECRET=<your-client-secret>
OAUTH2_OIDC_ISSUER_URL=https://auth.sorsiri.in/application/o/osbidian/

# CRITICAL: Must match the public domain users access AND must be registered
# in your Authentik OAuth2 provider redirect URIs list.
OAUTH2_REDIRECT_URL=https://aha.sorsiri.in/oauth2/callback

# Must be exactly 16, 24, or 32 ASCII characters. Regenerate with:
# python3 -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(32)))"
OAUTH2_COOKIE_SECRET=<generate-a-new-32-char-secret>

OAUTH2_EMAIL_DOMAIN=sorsiri.in,key2vibe.com

# IMPORTANT: Must be true for HTTPS deployments
OAUTH2_PROXY_COOKIE_SECURE=true
